# 运行时产物（结果、日志、权重、数据分片一律不入库）
/runs/
/data/
logs/
*.jsonl
*.pt
*.pth
*.ckpt
*.safetensors
*.zst
*.bin
!Kit/data/*.bin     # polyglot 开局书（自对弈开局注入要用，是数据不是分片）
__pycache__/
*.py[cod]
*.egg-info/
# 只忽略仓库根目录的 build/。**不要**写成裸 `build/`：那会连
# planes19/build/（数据构建包，Kit data evals|pgn|annotate|check 的实现）一起忽略掉
/build/
*.so
dist/

# 隐私：AI 会话导出、密钥、token
session-*.md
kimi-export-*.md
claude-history/
.env
*.known_hosts
id_rsa*
id_ed25519*

# 第三方二进制
stockfish*

# 备份文件
*.orig
*.bak
*.before-*
*~

# 系统
.DS_Store
Thumbs.db
